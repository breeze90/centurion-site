<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <script>
    (function () {
      if (sessionStorage.getItem('entrySource') !== null) return;
      var pageParams = new URLSearchParams(location.search);
      var hasRealTracking = pageParams.has('utm_source') || pageParams.has('yclid') || pageParams.has('gclid');
      var engine = '';
      if (!hasRealTracking) {
        try {
          var refHost = new URL(document.referrer).hostname;
          if (/(^|\.)yandex\.|(^|\.)ya\.ru$/i.test(refHost)) engine = 'yandex';
          else if (/(^|\.)google\./i.test(refHost)) engine = 'google';
        } catch (e) {}
      }
      sessionStorage.setItem('entrySource', engine);
      sessionStorage.setItem('entryPage', location.hostname + location.pathname);
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="format-detection" content="telephone=no">
  <meta name="robots" content="{{ robots or company.robots }}">
  <title>{{ title }} | {{ company.lowerName }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="../../assets/img/favicon-light.svg?v=20260721-theme" type="image/svg+xml">
  <link rel="icon" href="../../assets/img/favicon-light.svg?v=20260721-theme" media="(prefers-color-scheme: light)" type="image/svg+xml">
  <link rel="icon" href="../../assets/img/favicon-dark.svg?v=20260721-theme" media="(prefers-color-scheme: dark)" type="image/svg+xml">
  <link rel="shortcut icon" href="../../favicon.ico">
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Manrope:wght@400;600;700&display=swap&subset=cyrillic" rel="stylesheet">
  <link rel="stylesheet" href="../../assets/css/style.css?v=20260914-article-guide">
</head>
<body class="article-page">
  <header class="header">
    <div class="container header-inner">
      <button class="nav-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
      <a class="logo" href="../../">
        <img class="logo-mark" src="../../assets/img/logo-ink.svg" alt="{{ company.name }}" width="42" height="42">
        {{ company.name }}
      </a>
      <nav class="nav" aria-label="Основное меню">
        <a href="../" class="nav-current-section">Статьи</a>
        <a href="../../kontakty/">Контакты</a>
      </nav>
      <a class="header-phone" href="tel:{{ company.phoneHref }}">{{ company.phoneDisplay }}</a>
      <a class="btn btn-brass" href="#lead-form">Консультация</a>
    </div>
    <div class="mobile-nav" id="mobile-nav"></div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-layout">
        <div class="hero-copy">
          <p class="article-meta"><a href="../">Статьи</a></p>
          <h1>{{ title }}</h1>
          <p class="lead">{{ heroLead }}</p>
        </div>

        <figure class="hero-media" aria-hidden="true">
          <img class="hero-watermark" src="../../assets/img/logo-brass.svg?v=20260812-dark-section-gold" alt="" width="380" height="380">
        </figure>

        <div class="hero-facts">
          <div class="fact">
            <div class="fact-num">{{ readingTime }}</div>
            <div class="fact-cap">Время чтения</div>
          </div>
          <div class="fact">
            <div class="fact-num">{{ publishedAt }}</div>
            <div class="fact-cap">Дата написания</div>
          </div>
          <div class="fact">
            <div class="fact-num">{{ updatedAt }}</div>
            <div class="fact-cap">Последние изменения</div>
          </div>
        </div>
      </div>
    </section>

    <article>
      <div class="container article-prelude">
        <p>{{ prelude }}</p>
      </div>

      <nav class="article-toc" aria-label="Содержание статьи">
        <div class="container" style="padding:0;">
          <h2>Содержание</h2>
          <ol>
            {% for item in toc %}
            <li><a href="#{{ item.id }}">{{ item.title }}</a></li>
            {% endfor %}
          </ol>
        </div>
      </nav>

      {% if articleContent %}
      {% include articleContent %}
      {% else %}
      {{ content | safe }}
      {% endif %}
    </article>

    <section class="section lead-form" id="lead-form">
      <div class="container lead-form-layout">
        <div class="lead-form-copy">
          <span class="section-label">Следующий шаг</span>
          <h2>Начать с разбора вашей ситуации</h2>
          <p class="lead">Оставьте имя и телефон — юрист свяжется с вами в рабочее время.</p>
          <div class="lead-form-contact">
            <span>Или позвоните</span>
            <a href="tel:{{ company.phoneHref }}">{{ company.phoneDisplay }}</a>
          </div>
        </div>
        <div class="matomba-form" aria-label="Форма заявки">
          <iframe
            class="matomba-frame"
            data-src="https://31f130418eb552015102c26492c44c93.mtmba.ru"
            title="Оставить заявку на консультацию"
          ></iframe>
        </div>
      </div>
      <script>
        requestAnimationFrame(() => {
          const formFrame = document.querySelector('#lead-form .matomba-frame');
          const formUrl = new URL(formFrame.dataset.src);
          const engine = sessionStorage.getItem('entrySource');
          if (engine) {
            const entryPage = sessionStorage.getItem('entryPage') || (location.hostname + location.pathname);
            formUrl.searchParams.set('utm_source', engine);
            formUrl.searchParams.set('utm_medium', 'organic');
            formUrl.searchParams.set('utm_campaign', engine + '_seo');
            formUrl.searchParams.set('utm_content', 'source:' + entryPage);
            formUrl.searchParams.set('utm_term', 'seo');
          }
          formFrame.src = formUrl.toString();
        });
      </script>
    </section>

    <section class="section article-contacts" id="article-contacts">
      <div class="container">
        <div class="contacts-grid">
          <div class="contacts-intro">
            <span class="section-label">Контакты</span>
            <h2>Ждём вас в гости</h2>
            <p class="lead">Приглашаем вас в уютный офис в центре Москвы. Встречу необходимо согласовать заранее:
              в здании действует пропускной режим. Первичная консультация бесплатна.</p>
          </div>
          <div class="contacts-quick">
            <div class="contact-item">
              <h3>Телефон</h3>
              <p><a class="contact-big" href="tel:{{ company.phoneHref }}">{{ company.phoneDisplay }}</a></p>
            </div>
            <div class="contact-item">
              <h3>Почта</h3>
              <p><a class="contact-email" href="mailto:{{ company.email }}">{{ company.email }}</a></p>
            </div>
          </div>
          <div class="contacts-details">
            <div class="contact-item">
              <h3>Офис</h3>
              <p>Москва, ул. Кузнецкий Мост, д. 21/5, подъезд 3, этаж 3, офис 3033<br>
                м. Лубянка / Кузнецкий Мост</p>
              <div class="map-links" aria-label="Открыть компанию в картах">
                <a href="https://yandex.ru/maps/-/CTVSBHNF" target="_blank" rel="noopener" aria-label="Открыть компанию в Яндекс Картах">Яндекс Карты</a>
                <a href="https://2gis.ru/moscow/firm/70000001049989753" target="_blank" rel="noopener" aria-label="Открыть компанию в 2ГИС">2ГИС</a>
                <a href="https://maps.app.goo.gl/qhzcAWS59hRrLCBT9" target="_blank" rel="noopener" aria-label="Открыть компанию в Google Картах">Google Карты</a>
              </div>
            </div>
            <div class="contact-item contact-hours">
              <h3>Часы работы</h3>
              <p>Пн–пт: 11:00–19:00<br>Сб: 11:00–17:00</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div>ООО «{{ company.name }}» · ИНН 7725264363 · ОГРН 1157746168194</div>
      <div><a href="../../policy/">Политика конфиденциальности</a></div>
    </div>
  </footer>

  <script src="../../assets/js/nav.js?v=20260721-nav11" defer></script>
</body>
</html>
